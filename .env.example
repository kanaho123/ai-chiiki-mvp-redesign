# DB（Neon。DATABASE_URL は接続プール経由、DATABASE_URL_UNPOOLED は直接接続＝マイグレーション用）
# Dev Container 内では docker-compose の db サービスに接続してもよい
DATABASE_URL=postgresql://postgres:postgres@db:5432/ai_tiiki
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@db:5432/ai_tiiki

# seed / reset-demo を許可するデモ用 DB の Neon エンドポイント ID（例: ep-xxxx-xxxx）
# 接続先がこれと一致しない場合や元アプリの DB の場合、seed / reset-demo は実行されない
DEMO_DB_ENDPOINT=

# 既存アプリの編集用合言葉（新しい認証へ移行するまで一時的に使用）
EDIT_PASSPHRASE=

# セッション署名用の秘密値（十分に長いランダム値）
SESSION_SECRET=

# デモ環境の基準日時（JST）。通常利用では設定しない
DEMO_NOW=2026-10-22T12:00:00+09:00

# AI（Phase 4 で使用予定。未設定でも Phase 1〜3 は動作する。モデル名は未確定）
GEMINI_API_KEY=
GEMINI_MODEL=
