    "db:seed-general-master": "tsx scripts/seed-general-master.ts",
    "dev:general": "vite --mode general",
    "db:check-target": "tsx scripts/check-db-target.ts",
    "db:check-demo": "tsx scripts/check-demo-state.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
