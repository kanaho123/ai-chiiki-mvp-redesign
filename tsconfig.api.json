{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["api", "server", "src/lib", "prisma/seed.ts", "scripts"],
  // 運用用のツール（tsx で直接実行する。アプリ・Functions の型チェック対象外）
  "exclude": ["scripts/prod-ops"]
}
