{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/generated/prisma/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/auth/:route", "destination": "/api/auth?__path=/api/auth/:route" },
    { "source": "/api/onboarding/:route", "destination": "/api/onboarding?__path=/api/onboarding/:route" },
    { "source": "/api/approvals/received", "destination": "/api/approvals?__path=/api/approvals/received" },
    { "source": "/api/approvals/:id", "destination": "/api/approvals?__path=/api/approvals/:id" },
    { "source": "/api/approvals/:id/messages", "destination": "/api/approvals?__path=/api/approvals/:id/messages" },
    { "source": "/api/supplies/:id", "destination": "/api/supplies?__path=/api/supplies/:id" },
    { "source": "/api/me", "destination": "/api/account?__path=/api/me" },
    { "source": "/api/inbox", "destination": "/api/account?__path=/api/inbox" },
    { "source": "/api/profile", "destination": "/api/account?__path=/api/profile" },
    { "source": "/api/pickup-points", "destination": "/api/account?__path=/api/pickup-points" },
    { "source": "/api/catalog", "destination": "/api/purchase?__path=/api/catalog" },
    { "source": "/api/inventory-version", "destination": "/api/purchase?__path=/api/inventory-version" },
    { "source": "/api/plan", "destination": "/api/purchase?__path=/api/plan" },
    { "source": "/api/plan-options", "destination": "/api/purchase?__path=/api/plan-options" },
    { "source": "/api/item-suggestions", "destination": "/api/purchase?__path=/api/item-suggestions" },
    { "source": "/api/supply-draft", "destination": "/api/extract?__path=/api/supply-draft" },
    { "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
