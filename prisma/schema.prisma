generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  moduleFormat        = "esm"
  // 生成する import を必ず ./internal/class.js のように .js 付きにする（Vercel の Node.js（ESM）で読み込めるように。
  // 指定しないと tsconfig の moduleResolution によって拡張子なしになり、本番で ERR_MODULE_NOT_FOUND になる）
  importFileExtension = "js"
  // native: 手元の Windows、rhel-openssl-3.0.x: Vercel Functions（Node.js 22）
  binaryTargets       = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 接続プール経由（アプリ実行時）
  directUrl = env("DATABASE_URL_UNPOOLED") // 直接接続（マイグレーション時）
}

// ============================================================
// 新仕様（01_spec_updated.md 9.1）のデータモデル
// テーブル名は snake_case にして、旧モデルのテーブル（"Producer" / "Listing"）と衝突させない。
// 数量は整数kg、単価は税込整数円/kg。Request / Plan は DB に保存しない。
// ============================================================

enum UserRole {
  restaurant
  producer
}

// 規格。regular=通常品、irregular=規格外品
enum SupplyGrade {
  regular
  irregular
}

model User {
  id               String            @id @default(cuid())
  role             UserRole
  displayName      String
  loginId          String?           @unique // ログイン用の内部ID。デモは demo-r 等、一般ユーザーは登録時に自動生成（u- で始まる・画面に出さない）
  passwordHash     String? // scrypt のハッシュ（平文は保存しない）。null ならログイン不可
  email            String?           @unique // 一般ユーザーのログイン用（小文字に正規化して保存）。デモは null
  legalAcceptedAt  DateTime? // 利用規約・プライバシーポリシーに同意した日時（1つのチェックで両方に同意）
  termsVersion     String? // 同意した利用規約の版
  privacyVersion   String? // 同意したプライバシーポリシーの版
  onboardedAt      DateTime? // オンボーディング完了。null ならオンボーディングへ誘導
  createdAt        DateTime          @default(now())
  producer         Producer?
  restaurant       Restaurant?
  relationships    Relationship[]
  approvalRequests ApprovalRequest[]
  tradeMessages    TradeMessage[]

  @@map("users")
}

model Producer {
  id                    String                  @id @default(cuid())
  ownerUserId           String                  @unique // 1ユーザー1農園（適用前に各DBで重複0件を確認する）
  owner                 User                    @relation(fields: [ownerUserId], references: [id])
  farmName              String
  originPrefecture      String // 産地（都道府県）
  relationships         Relationship[]
  slots                 SlotParticipant[]
  supplies              Supply[]
  contactPhone          String?
  contactEmail          String?
  approvalRequests      ApprovalRequest[]
  producerName          String?
  city                  String?
  otherCrops            String? // プロフィール用の自由記入。出品できるのは品目マスタにある品目だけ
  productionStyle       ProductionStyle?
  salesChannels         SalesChannel[]          @default([])
  directTradeExperience DirectTradeExperience?
  capabilities          ProducerCapability[]    @default([])
  mainItems             ProducerItem[]
  seriesMemberships     SlotSeriesParticipant[]
  ownedPlaces           Place[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  @@index([ownerUserId]) // 既存の索引は残す（unique と重複するが、削除しないことで追加のみの変更にする）
  @@map("producers")
}

enum ProductionStyle {
  many_small // 少量多品目
  specialized // 特定品目中心
  seasonal // 季節によって変わる
  other
}

enum SalesChannel {
  market // 市場
  ja
  direct_store // 直売所
  restaurant // 飲食店
  ec
  other
}

enum DirectTradeExperience {
  often // よくある
  sometimes // 何度かある
  rarely // ほとんどない
  never // 初めて
}

enum ProducerCapability {
  small_lot // 少ない量でも販売できる
  irregular // 規格外も販売できる
  surplus // 余った分だけでも販売できる
  direct_talk // 飲食店と直接相談できる
}

// 主な作物（品目マスタへの参照）
model ProducerItem {
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])

  @@id([producerId, itemId])
  @@index([itemId])
  @@map("producer_items")
}

// 飲食店プロフィール（User と 1対1。承認依頼・取引経験は従来どおり User を指す）
model Restaurant {
  id                String             @id @default(cuid())
  ownerUserId       String             @unique
  owner             User               @relation(fields: [ownerUserId], references: [id])
  name              String
  businessType      BusinessType
  businessTypeOther String? // businessType=other のときの業態（短い自由記入）
  prefecture        String
  city              String
  address           String? // 任意・後から設定可。生産者には表示しない
  phone             String? // 任意。生産者には表示しない
  purchaseFrequency PurchaseFrequency?
  purchaseVolume    PurchaseVolume?
  irregularPolicy   IrregularPolicy?
  firstTimePolicy   FirstTimePolicy?
  pickupTimes       PickupTime[]       @default([])
  priorities        PurchasePriority[] @default([]) // 最大3（アプリで検証）
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  @@map("restaurants")
}

enum BusinessType {
  japanese // 和食
  izakaya // 居酒屋
  italian
  french
  cafe
  bakery
  chinese
  western // 洋食
  other
}

enum PurchaseFrequency {
  almost_daily // ほぼ毎日
  few_times_weekly // 週2〜3回
  weekly // 週1回
  as_needed // 必要なときだけ
}

enum PurchaseVolume {
  small // 少量中心
  kg5_10
  kg10_30
  kg30_plus
}

enum IrregularPolicy {
  welcome // 積極的に使いたい
  depends // 条件次第
  avoid // 基本使わない
}

enum FirstTimePolicy {
  include // 候補に含めてOK
  prefer_known // 取引済み生産者を優先
}

enum PickupTime {
  early_morning
  morning
  afternoon
  evening
  any // 特になし
}

enum PurchasePriority {
  local // 近くで作られている
  freshness
  price
  stable_supply
  small_lots
  use_irregular
  rare_items
  direct_connection
}

// 店ごとの取引経験の申告。アプリ内の成約実績ではない。
model Relationship {
  restaurantUserId String
  restaurant       User     @relation(fields: [restaurantUserId], references: [id])
  producerId       String
  producer         Producer @relation(fields: [producerId], references: [id])
  priorTrade       Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@id([restaurantUserId, producerId])
  @@map("relationships")
}

model Item {
  id            String         @id @default(cuid())
  name          String         @unique
  varieties     Variety[]
  supplies      Supply[]
  producerItems ProducerItem[]

  @@map("items")
}

model Variety {
  id       String   @id @default(cuid())
  itemId   String
  item     Item     @relation(fields: [itemId], references: [id])
  name     String
  supplies Supply[]

  @@unique([itemId, name])
  @@map("varieties")
}

model Place {
  id              String         @id @default(cuid())
  name            String
  address         String
  slots           HandoverSlot[]
  series          SlotSeries[]
  // 生産者が登録した受け渡し地点（普段の出荷・移動のついでに受け渡せる場所）。運営が用意した拠点はすべて null のまま
  kind            PlaceKind?
  note            String?
  ownerProducerId String?
  owner           Producer?      @relation(fields: [ownerProducerId], references: [id], onDelete: Restrict)

  @@index([ownerProducerId])
  @@map("places")
}

/// 生産者が登録した受け渡し地点の種類
enum PlaceKind {
  direct_store // 直売所
  collection_point // 集荷場
  shipping_destination // 出荷先
  farm // 農園
  other // その他
}

// 共通受渡枠。費用は「同じ枠を使う1案に一回」の税込固定費のみ。
model HandoverSlot {
  id                  String            @id @default(cuid())
  placeId             String
  place               Place             @relation(fields: [placeId], references: [id])
  label               String // 表示名（例: G-P）
  startAt             DateTime
  endAt               DateTime
  confirmDeadlineAt   DateTime
  feeYen              Int
  feeConfirmed        Boolean           @default(false)
  maxKg               Int
  conditionsConfirmed Boolean           @default(false)
  participants        SlotParticipant[]
  supplies            Supply[]
  seriesId            String? // 定期枠から作った回なら、その定期枠
  series              SlotSeries?       @relation(fields: [seriesId], references: [id])

  @@unique([seriesId, startAt])
  @@index([placeId])
  @@map("handover_slots")
}

// 受渡の定期枠（運営がスクリプトで管理。曜日・時刻はサービス基準の Asia/Tokyo）
model SlotSeries {
  id            String                  @id @default(cuid())
  placeId       String
  place         Place                   @relation(fields: [placeId], references: [id])
  label         String // 例「毎週金曜 午前」
  weekday       Int // 0=日〜6=土（Asia/Tokyo）
  startTime     String // "10:00"（Asia/Tokyo）
  endTime       String // "11:00"（Asia/Tokyo）
  deadlineHours Int // 受渡開始の何時間前を確認締切にするか
  feeYen        Int
  maxKg         Int
  // active=false（MVP の意味）：新しい生産者は参加できない（初回登録 API が拒否）・今後の受渡の回を作る対象から外す（seed-general-master）。
  // すでに作った受渡の回（HandoverSlot）や参加者は、自動で削除・取り消ししない（受渡の回の取り消しは別の機能として扱う）
  active        Boolean                 @default(true)
  slots         HandoverSlot[]
  participants  SlotSeriesParticipant[]

  @@index([placeId])
  @@map("slot_series")
}

// 生産者がオンボーディングで選ぶ「利用できる受渡場所・時間」
model SlotSeriesParticipant {
  seriesId   String
  series     SlotSeries @relation(fields: [seriesId], references: [id])
  producerId String
  producer   Producer   @relation(fields: [producerId], references: [id])
  joinedAt   DateTime   @default(now())

  @@id([seriesId, producerId])
  @@index([producerId])
  @@map("slot_series_participants")
}

model SlotParticipant {
  slotId     String
  slot       HandoverSlot @relation(fields: [slotId], references: [id])
  producerId String
  producer   Producer     @relation(fields: [producerId], references: [id])
  confirmed  Boolean      @default(false)

  @@id([slotId, producerId])
  @@map("slot_participants")
}

// 供給。1農家・1品目・1枠につき1供給（同一ロットの複製出品を認めない）。
model Supply {
  id               String       @id @default(cuid())
  producerId       String
  producer         Producer     @relation(fields: [producerId], references: [id])
  itemId           String
  item             Item         @relation(fields: [itemId], references: [id])
  varietyId        String
  variety          Variety      @relation(fields: [varietyId], references: [id])
  grade            SupplyGrade  @default(regular)
  irregularReason  String? // grade=irregular のときの理由
  originPrefecture String
  availableKg      Int
  priceYenPerKg    Int
  minKg            Int          @default(1)
  slotId           String
  slot             HandoverSlot @relation(fields: [slotId], references: [id])
  published        Boolean      @default(false)
  updatedAt        DateTime     @updatedAt
  version          Int          @default(1) // 更新ごとに +1。競合検出に使う

  @@unique([producerId, itemId, slotId])
  @@index([slotId])
  @@map("supplies")
}

// ログイン失敗の記録（総当たり対策）。サーバーレスでもインスタンス間で共有するため DB に置く。
// key は「ログイン名|接続元」または「ip:接続元」。パスワード等は保存しない
model AuthThrottle {
  key         String    @id
  failures    Int
  firstAt     DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("auth_throttles")
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// A confirmation to discuss directly, never an order or inventory reservation.
model ApprovalRequest {
  id              String         @id @default(cuid())
  restaurantId    String
  restaurant      User           @relation(fields: [restaurantId], references: [id])
  producerId      String
  producer        Producer       @relation(fields: [producerId], references: [id])
  supplyId        String
  planFingerprint String
  planVersion     String
  planRequest     Json
  itemName        String
  quantityKg      Int
  priceYenPerKg   Int
  subtotalYen     Int
  pickupStartAt   DateTime
  pickupEndAt     DateTime
  pickupPlace     String
  status          ApprovalStatus @default(pending)
  createdAt       DateTime       @default(now())
  respondedAt     DateTime?
  // 受け取り完了（＝取引完了）。同じ仕入れ案の「対応できます」の行すべてに、飲食店が1回の操作で同じ時刻を入れる
  receivedAt      DateTime?
  messages        TradeMessage[]

  @@unique([restaurantId, supplyId, planFingerprint])
  @@index([producerId, createdAt])
  @@index([restaurantId, planFingerprint])
  @@map("approval_requests")
}

// 取引のやり取り（テキストだけ）。相談1件（飲食店 × 生産者 × 仕入れ案）に紐づく。読み書きはその飲食店と生産者だけ
model TradeMessage {
  id                String          @id @default(cuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  senderUserId      String
  sender            User            @relation(fields: [senderUserId], references: [id])
  body              String // 1〜1000文字（前後の空白を除いたもの）
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId, createdAt])
  @@map("trade_messages")
}

// ============================================================
// Legacy（旧仕様の出品モデル）。現行画面を壊さないため一時的に残す。
// Phase 2 で Supply へ完全移行した後に削除する。
// ============================================================

// 旧・生産者。テーブル名は既存の "Producer" のまま。
model LegacyProducer {
  id       String    @id @default(cuid())
  name     String
  listings Listing[]

  @@map("Producer")
}

// 旧・出品（今回販売に回せる量）。数量・金額は整数で扱う。
model Listing {
  id              String         @id @default(cuid())
  producerId      String
  producer        LegacyProducer @relation(fields: [producerId], references: [id])
  item            String
  variety         String? // 品種（任意）
  quantity        Int
  unit            String
  unitPrice       Int // 税込単価（円/単位）
  availableDate   String // 販売可能日＝受渡日（日本時間 YYYY-MM-DD）
  region          String
  irregularReason String? // null は通常品
  handoverPlace   String
  handoverStart   String // HH:MM
  handoverEnd     String // HH:MM
  minQuantity     Int
  step            Int
  handoverFee     Int            @default(0) // 1出品あたりの受渡手数料（円）
  isPublic        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([item])
}
